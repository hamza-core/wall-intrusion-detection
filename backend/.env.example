# Wall Intrusion Detection Backend — Environment Variables
#
# Copy this file to .env and edit as needed.
# All values below are the defaults. You only need to set a variable
# if you want to override the default.
#
#   cp .env.example .env

# ---------------------------------------------------------------
# Paths (relative to the ML project root unless absolute)
# ---------------------------------------------------------------
# YOLO_WEIGHTS=../yolo11n-pose.pt
# LSTM_CHECKPOINT=../artifacts/models/multi_person_region_lstm2.pth
# UPLOAD_DIR=./uploads

# ---------------------------------------------------------------
# API
# ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum video upload size in bytes (default: 500 MB)
# MAX_UPLOAD_BYTES=524288000

# ---------------------------------------------------------------
# Inference (do not change unless you retrain the model)
# ---------------------------------------------------------------
# SEQUENCE_LENGTH=30
# MAX_PEOPLE=5
# FEATURE_SIZE=103
# HIDDEN_SIZE=64
# NUM_LAYERS=2
# DROPOUT=0.3
# THRESHOLD=0.5
# IMAGE_SIZE=640
# YOLO_CONF=0.25
